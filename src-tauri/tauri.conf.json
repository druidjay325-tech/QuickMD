{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickMD",
  "version": "0.6.7",
  "identifier": "com.quickmd.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run prepare:acrylic && npm run dev",
    "beforeBuildCommand": "npm run prepare:acrylic && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuickMD - 闪念便利贴",
        "width": 900,
        "height": 650,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true,
        "minWidth": 560,
        "minHeight": 360
      },
      {
        "label": "float",
        "title": "QuickMD - 闪念便利贴",
        "width": 400,
        "height": 300,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "visible": true,
        "alwaysOnTop": true,
        "dragDropEnabled": true,
        "minWidth": 340,
        "minHeight": 240
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "安静、可靠的本地 Markdown 闪念便利贴",
    "category": "Productivity",
    "resources": [
      "resources/acrylic/quickmd-acrylic.dll",
      "resources/acrylic/Microsoft.WindowsAppRuntime.Bootstrap.dll",
      "resources/acrylic/SDK-LICENSE.txt",
      "resources/acrylic/CPPWINRT-LICENSE.txt"
    ]
  }
}
